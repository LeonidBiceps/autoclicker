{
  "manifest_version": 3,
  "name": "Трекер цен",
  "version": "1.5.0",
  "description": "Запоминает цену товара (включая Wildberries), показывает историю и предупреждает про накрученные «старые цены»; в поиске Wildberries считает цену за 100г/100мл/шт на каждой карточке, а на странице отзывов считает явные упоминания «маломерит/большемерит».",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "notifications"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sparkline.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
