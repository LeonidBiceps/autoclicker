{
  "manifest_version": 3,
  "name": "Автокликер",
  "version": "1.7.6",
  "description": "Сам кликает под курсором, в точке или по цепочке точек, либо жмёт клавишу. Глобальные хоткеи, аварийный стоп. Pro (офлайн-лицензия): без лимита кликов за запуск, последовательность точек, разброс позиции, профили настроек, экспорт/импорт.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-autoclicker": {
      "suggested_key": { "default": "Ctrl+Shift+K" },
      "description": "Старт/стоп автокликера (работает даже если фокус не на странице)"
    },
    "panic-stop-autoclicker": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Аварийный стоп автокликера"
    }
  },
  "permissions": ["storage", "contextMenus", "downloads"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["license.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
