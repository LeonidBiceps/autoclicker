{
  "manifest_version": 3,
  "name": "Счётчик текста",
  "version": "1.1.0",
  "description": "Символы, слова и время чтения прямо над полем ввода — для копирайтеров и SEO.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
